{
  "name": "youcune-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // youcune.com 以外（*.workers.dev やバージョンごとのプレビュー URL）では公開しない
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // directory_indexes で生成される /foo/ → foo/index.html
    "html_handling": "auto-trailing-slash",
    // 存在しない URL には build/404.html を 404 で返す
    "not_found_handling": "404-page",
    // 画像のときだけ Worker を通して WebP を出し分ける（それ以外は静的配信で無料枠を消費しない）
    "run_worker_first": ["/images/*"]
  },
  "routes": [
    { "pattern": "youcune.com", "custom_domain": true }
  ]
}
