// -----------------------------------------------------------------
// FontAwesome
// -----------------------------------------------------------------
:root {
  <%
    brand_icons = %w[bluesky x-twitter wikipedia-w]
    brand_icons.each do |icon|
  %>
      --fa-<%= icon %>: <%= svg_data_url('brands', icon) %>;
  <% end %>

  <%
    solid_icons = %w[clock tag tags calendar-alt calendar-day info-circle]
    solid_icons.each do |icon|
  %>
      --fa-<%= icon %>: <%= svg_data_url('solid', icon) %>;
  <% end %>
}

<% (brand_icons + solid_icons).each do |icon| %>
.fa-<%= icon %> {
  display: inline-block;
  width: 1em;
  height: 1em;
  background: currentColor;
  vertical-align: -0.125em;
  -webkit-mask: var(--fa-<%= icon %>) no-repeat center / contain;
  mask: var(--fa-<%= icon %>) no-repeat center / contain;
}
<% end %>

// -----------------------------------------------------------------
// Variables & Mixins
// -----------------------------------------------------------------
$color: #333;
$gray-dark: #999;
$gray-light: #ccc;
$gray-lighter: #eee;
$primary: #4CB55B;
$spacer: 1rem;
$font-size-sm: 0.8rem;
$breakpoints: (m: 0, d: 800px);
$button-colors: ('bluesky': #0085ff, 'x': #000000);

@mixin media-breakpoint($breakpoint) {
  @media (min-width: map-get($breakpoints, $breakpoint)) {
    @content;
  }
}

// -----------------------------------------------------------------
// Base
// -----------------------------------------------------------------
body {
  font-family: "Lucida Grande","Trebuchet MS","Droid Sans","游ゴシック体",YuGothic,"游ゴシック","Yu Gothic",sans-serif;
  color: $color;
  line-height: 1.732;
}

h1 {
  font-size: 2rem;
  line-height: 1.414;
}

a {
  color: $primary;
  text-decoration: none;
  &:hover {
    text-decoration: underline;
  }
}

table {
  width: 100%;
  max-width: 100%;
  margin-bottom: $spacer;
  border: 1px solid $gray-light;
  border-collapse: collapse;

  th,
  td {
    padding: $spacer/2;
    vertical-align: top;
    border-top: 1px solid $gray-light;
    border: 1px solid $gray-light;
  }

  thead {
    th {
      vertical-align: bottom;
      border-bottom: 2px solid $gray-light;
    }

    th,
    td {
      border-bottom-width: 2px;
    }
  }
}

hr {
  border: 0;
  text-align: center;
  margin: $spacer;
  &:after {
    content: '◆';
    display: inline-block;
    color: $gray-light;
  }
}

img {
  max-width: 100%;
  height: auto;
}

blockquote {
  margin: 0 0 1rem;
  border-left: $gray-light 4px solid;
  padding: 0 1rem;
}

// すべての <code> と <kbd> に赤系スタイル
code,
kbd {
  background-color: #fff0f0;
  color: #b00020;
  font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
  font-size: 0.95em;
  border-radius: 6px;
  padding: 0.2em 0.4em;
}

kbd {
  font-weight: bold;
  box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.25);
  border: 1px solid #ccc;
}

// Markdown由来のコードブロック: <pre><code>
pre code {
  background-color: #f8f8f8 !important;
  color: #333 !important;
  padding: 0 !important;
  border-radius: 0 !important;
}

pre {
  background-color: #f8f8f8;
  padding: 1em;
  overflow: auto;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
  border-radius: 6px;
}

article {
  max-width: 800px;
  margin: 0 auto 2rem;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.meta {
  color: #999;
  font-size: $font-size-sm;
}

ul.meta {
  list-style: none;
  padding: 0;
  margin: 0 0 calc($spacer - 8px);

  li {
    display: inline-block;
    margin-bottom: 8px;
  }
}

.columns {
  @include media-breakpoint(d) {
    column-count: 3;
  }
}

// -----------------------------------------------------------------
// Cards
// -----------------------------------------------------------------
.card {
  display: inline-block; // text-decoration が継承されなくなる
  border: 1px solid #ccc;
  break-inside: avoid;
  margin-bottom: 1rem;
  width: 100%;

  .card-img-top {
    width: 100%;
    height: auto;
  }

  .card-title {
    margin-top: $spacer/2;
  }

  .card-body {
    padding: 0 $spacer;
  }
}

a {
  .card {
    color: $color;
  }
}

// -----------------------------------------------------------------
// Lists
// -----------------------------------------------------------------
.list-unstyled,
.list-inline {
  padding-left: 0;
  list-style: none;
}

.list-inline > li {
  display: inline-block;
  line-height: 1.5;
}

// -----------------------------------------------------------------
// Buttons
// -----------------------------------------------------------------
// Base
.btn {
  background-color: $primary;
  border: none;
  border-radius: 2px;
  color: #fff;
  text-decoration: none;
  padding: $spacer/2 $spacer;

  &:hover {
    background-image: linear-gradient(transparent, rgba(0,0,0, 0.05) 40%, rgba(0,0,0, 0.10));
    text-decoration: none;
  }
}

// Colors
@each $name, $color in $button-colors {
  .btn-#{$name} {
    background-color: $color;
  }
}

// Sizes
.btn-sm {
  font-size: $font-size-sm;
  padding: $spacer/4 $spacer/2;
}

// Outline
.btn-outline {
  background-color: #fff;
  color: $primary;
  border: 1px solid $primary;

  &:hover {
    background-color: $primary;
    color: #fff;
  }
}

// -----------------------------------------------------------------
// Callouts
// -----------------------------------------------------------------

.callout {
  position: relative;
  margin: 0 0 1rem;
  padding: 0.75rem 1rem;
  padding-left: 2.6rem;

  border: 1px solid #8fd0e6;
  border-radius: 6px;
  background-color: #e6f4f9;
  color: #024c63;

  &::before {
    content: "";
    position: absolute;
    left: 1rem;
    top: 1.1rem;
    width: 1rem;
    height: 1rem;
    background: currentColor;
    -webkit-mask: var(--fa-info-circle) no-repeat center / contain;
    mask: var(--fa-info-circle) no-repeat center / contain;
  }
}
